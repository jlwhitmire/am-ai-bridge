# AM-AI MCP bridge configuration. Copy to .env and fill in real values.
# NEVER commit the real .env (see .gitignore).

# REQUIRED. Bearer token the agent must present on every /mcp call.
# Must be >= 32 chars or the bridge rejects ALL requests (fails closed).
# Generate a strong one, e.g.:   openssl rand -hex 32
MCP_BEARER_TOKEN=replace-with-a-64-char-hex-token-generated-via-openssl-rand-hex-32

# Ollama HTTP API base URL as seen from INSIDE the bridge container.
# Default reaches the host via the host-gateway mapping in docker-compose.yml.
# Override with the host IP if host.docker.internal is unavailable, e.g. http://192.168.1.50:11434
OLLAMA_URL=http://host.docker.internal:11434

# Optional. Path (inside the container) to an app log file for tail_app_logs.
# Leave unset to disable that tool. If set, mount the real log read-only via the
# commented volume in docker-compose.yml.
# APP_LOG_FILE=/logs/app.log

# Optional. Host path of the app log to mount (used by the commented volume).
# APP_LOG_HOST_PATH=/var/log/openwebui.log

# Optional. Disk path get_system_health reports usage for. Default "/".
DISK_PATH=/

# Port the bridge listens on (inside the container and published on 127.0.0.1).
MCP_PORT=3102
